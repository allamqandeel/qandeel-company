{
  "name": "qandeel-company",
  "version": "0.0.0",
  "private": true,
  "description": "QANDEEL COMPANY - bespoke local-first AI company that operates the QANDEEL product/business. C1 durable runtime foundation (canonical) + C2 Employees, Models, Tools and Cost Governance (implementation candidate).",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "workspaces": [
    "packages/bootstrap-contract",
    "packages/domain",
    "packages/governance",
    "packages/mind",
    "packages/secret-vault",
    "packages/model-providers",
    "packages/tool-drivers",
    "packages/storage",
    "packages/runtime",
    "packages/command-center-ui",
    "packages/command-center"
  ],
  "engines": {
    "node": ">=24.12.0 <25.0.0",
    "npm": ">=11.6.0 <12.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint --max-warnings=0 .",
    "test": "npm run test --workspaces && npm run test:harness",
    "test:harness": "node --test scripts/c5/cdp.test.mjs",
    "verify": "node scripts/verify-bootstrap.mjs",
    "c1:integration": "npm run test:multiprocess --workspace @qandeel-company/storage && npm run test:integration --workspace @qandeel-company/runtime",
    "c1:faults": "npm run test:faults --workspace @qandeel-company/runtime",
    "c1:acceptance": "node scripts/c1-acceptance.mjs",
    "c1:mutation": "node scripts/c1-mutation-check.mjs",
    "ci": "node scripts/ci/validate-affected.mjs",
    "validate:affected": "node scripts/ci/validate-affected.mjs",
    "validate:plan": "node scripts/ci/validate-affected.mjs --plan-only",
    "desktop:bundle": "node packaging/windows/build.mjs",
    "desktop:setup": "node packaging/windows/build.mjs --setup",
    "desktop:verify": "node packaging/windows/verify.mjs",
    "desktop:proof": "node packaging/windows/proof/desktop-proof.mjs",
    "desktop:control-proof": "node packaging/windows/proof/desktop-control-proof.mjs",
    "desktop:e2e": "node packaging/windows/proof/desktop-e2e.mjs",
    "c2:mutation": "node scripts/c2-mutation-check.mjs",
    "c2:acceptance": "node --conditions=qandeel-test scripts/c2-acceptance.mjs",
    "c3:mutation": "node scripts/c3-mutation-check.mjs",
    "c3:acceptance": "node --conditions=qandeel-test scripts/c3-acceptance.mjs",
    "r1:mutation": "node scripts/r1-mutation-check.mjs",
    "c4:mutation": "node scripts/c4-mutation-check.mjs",
    "c4:acceptance": "node --conditions=qandeel-test scripts/c4-acceptance.mjs",
    "c5:mutation": "node scripts/c5-mutation-check.mjs",
    "c5:acceptance": "node --conditions=qandeel-test scripts/c5-acceptance.mjs",
    "c5:visual-proof": "node --conditions=qandeel-test scripts/c5-visual-proof.mjs",
    "c5:spike": "node --conditions=qandeel-test scripts/c5-visual-proof.mjs --spike",
    "c6:mutation": "node scripts/c6-mutation-check.mjs",
    "c6:acceptance": "node --conditions=qandeel-test scripts/c6-acceptance.mjs",
    "c7a:mutation": "node scripts/c7a-mutation-check.mjs",
    "c7b:mutation": "node scripts/c7b-mutation-check.mjs",
    "c7c:mutation": "node scripts/c7c-mutation-check.mjs",
    "c7d:mutation": "node scripts/c7d-mutation-check.mjs",
    "l1:mutation": "node scripts/l1-mutation-check.mjs",
    "l1:smoke": "node --conditions=qandeel-test scripts/l1-deepseek-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
