root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
# Windows PowerShell 5.1 reads BOM-less files as ANSI and corrupts UTF-8 (including Arabic).
charset = utf-8-bom
end_of_line = crlf

[*.{cmd,bat}]
end_of_line = crlf
