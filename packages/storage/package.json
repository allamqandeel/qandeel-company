{
  "name": "@qandeel-company/storage",
  "version": "0.1.0",
  "private": true,
  "description": "C1 storage layer: Company Workspace, SQLite/WAL operational store behind a narrow adapter, versioned migrations, repositories, Artifact Store and online backup.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./runtime-authority": {
      "types": "./dist/src/runtime-authority.d.ts",
      "default": "./dist/src/runtime-authority.js"
    },
    "./testing": {
      "qandeel-test": {
        "types": "./dist/src/testing/founder-seam.d.ts",
        "default": "./dist/src/testing/founder-seam.js"
      },
      "default": null
    }
  },
  "engines": {
    "node": ">=24.12.0 <25.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../../scripts/run-node-tests.mjs",
    "test:multiprocess": "node ../../scripts/run-node-tests.mjs multiprocess"
  },
  "dependencies": {
    "@qandeel-company/domain": "0.1.0",
    "@qandeel-company/governance": "0.2.0"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
